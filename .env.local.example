# Copy this file to .env.local and fill in real values. Never commit .env.local

# MongoDB — REQUIRED. Nothing runs without this.
MONGODB_URI=

# JWT — REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary — optional. Only needed to upload product images from the admin panel.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay — legacy integration only; not required for the active PayPlus checkout.
# The public Key ID is returned by the server; no NEXT_PUBLIC copy is required.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate secret configured in Razorpay Dashboard for payment.captured webhooks.
RAZORPAY_WEBHOOK_SECRET=

# Email — optional. Without it, emails print to your terminal instead of sending.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# PayPlus — server-side credentials from https://payplus.live/merchant/developer
PAYPLUS_API_KEY=
PAYPLUS_WEBHOOK_SECRET=

# Guest checkout: email OTP by default; console SMS is for local testing only.
GUEST_OTP_REQUIRED=true
OTP_CHANNEL=email
SMS_PROVIDER=console
